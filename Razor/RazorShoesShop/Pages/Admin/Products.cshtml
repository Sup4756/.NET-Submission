@page "/Admin/Products"
@model RazorShoesShop.Pages.AdminProductsModel
@{ var s=Model.State; }
<div asp-validation-summary="All" class="validation"></div>
<div class="section-heading"><div><span class="eyebrow">DANH MỤC CỬA HÀNG</span><h1>Quản lý sản phẩm</h1></div><a class="button" href="/Admin/Products/Edit">+ Thêm sản phẩm</a></div><form class="search-row" method="get"><input name="q" value="@s.Q" placeholder="Tìm theo tên hoặc thương hiệu"/><button>Tìm kiếm</button></form><div class="panel table-wrap"><table><thead><tr><th>Sản phẩm</th><th>Thương hiệu</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in s.Products){<tr><td><a href="/Products/@p.Id">@p.Name</a></td><td>@p.Brand</td><td>@p.Category</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Stock</td><td class="actions"><a href="/Products/@p.Id">Xem</a><a href="/Admin/Products/Edit/@p.Id">Sửa</a><form method="post" action="@($"/Admin/Products?handler=Delete&id={p.Id}")">@Html.AntiForgeryToken()<button class="danger" onclick="return confirm('Xóa sản phẩm này?')">Xóa</button></form></td></tr>}</tbody></table>@if(s.Products.Count==0){<p>Không có sản phẩm phù hợp.</p>}</div>
