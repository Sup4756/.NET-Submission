@page "/Admin/Customers"
@model RazorShoesShop.Pages.AdminCustomersModel
@{ var s=Model.State; }
<div asp-validation-summary="All" class="validation"></div>
<div class="page-heading"><span class="eyebrow">NGƯỜI DÙNG HỆ THỐNG</span><h1>Khách hàng &amp; tài khoản</h1></div><form method="get" class="panel user-filter"><input name="q" value="@s.Q" placeholder="Họ tên, email, SĐT, địa chỉ"/><input name="city" placeholder="Thành phố"/><input name="birthDate" type="date" aria-label="Ngày sinh"/><select name="role"><option value="">Mọi vai trò</option><option>User</option><option>Admin</option></select><select name="gender"><option value="">Mọi giới tính</option><option>Nam</option><option>Nữ</option><option>Khác</option></select><select name="locked"><option value="">Mọi trạng thái</option><option value="false">Hoạt động</option><option value="true">Đã khóa</option></select><button>Lọc</button></form><div class="panel table-wrap"><table><thead><tr><th>Khách hàng</th><th>Email / SĐT</th><th>Giới tính / Ngày sinh</th><th>Địa chỉ / Thành phố</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in s.Users){<tr><td>@u.FullName</td><td>@u.Email<br/><small>@u.PhoneNumber</small></td><td>@u.Gender<br/><small>@u.DateOfBirth?.ToString("dd/MM/yyyy")</small></td><td>@u.Address<br/><small>@u.City</small></td><td>@s.Roles.GetValueOrDefault(u.Id,"User")</td><td><span class="badge">@(u.LockoutEnd>DateTimeOffset.UtcNow?"Đã khóa":"Hoạt động")</span></td><td class="actions"><a href="/Admin/Accounts/Edit/@u.Id">Xem / Sửa</a><form method="post" action="@($"/Admin/Accounts?handler=Delete&id={u.Id}")">@Html.AntiForgeryToken()<button class="danger" onclick="return confirm('Xóa mềm tài khoản này?')">Xóa</button></form></td></tr>}</tbody></table>@if(s.Users.Count==0){<p>Không tìm thấy tài khoản.</p>}</div>
