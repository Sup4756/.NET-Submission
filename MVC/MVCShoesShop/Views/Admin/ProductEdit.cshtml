@model ShoesShop.Core.ShopState
@{ var s=Model; }
<div asp-validation-summary="All" class="validation"></div>
<div class="page-heading"><span class="eyebrow">SẢN PHẨM</span><h1>@(s.Product!.Id==0?"Thêm sản phẩm":"Sửa sản phẩm")</h1></div><section class="panel editor"><form method="post" action="@($"/Admin/Products/Edit/{s.Product!.Id}")">@Html.AntiForgeryToken()<div class="form-grid"><label>Tên sản phẩm<input name="Input.Name" value="@s.Product.Name" required maxlength="120"/></label><label>Thương hiệu<input name="Input.Brand" value="@s.Product.Brand" required maxlength="60"/></label><label>Danh mục<input name="Input.Category" value="@s.Product.Category" required maxlength="60"/></label><label>Giá (₫)<input name="Input.Price" type="number" min="1000" max="100000000" value="@s.Product.Price" required/></label><label>Tồn kho<input name="Input.Stock" type="number" min="0" max="100000" value="@s.Product.Stock" required/></label><label class="full">Mô tả<textarea name="Input.Description" required maxlength="3000">@s.Product.Description</textarea></label></div><button>Lưu sản phẩm</button><a href="/Admin/Products">Quay lại</a></form></section>
