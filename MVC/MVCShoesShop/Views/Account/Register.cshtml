@model MVCShoesShop.Models.ShopState
@{ var s=Model; }
<div asp-validation-summary="All" class="validation"></div>
<section class="auth panel"><span class="eyebrow">GIA NHẬP STEP SHOES</span><h1>Tạo tài khoản</h1><form method="post" action="/Account/Register">@Html.AntiForgeryToken()<label>Họ và tên<input name="Input.FullName" required maxlength="100" value="@s.Register.FullName"/></label><label>Email<input type="email" name="Input.Email" required value="@s.Register.Email" autocomplete="username"/></label><label>Mật khẩu<input type="password" name="Input.Password" required minlength="8" autocomplete="new-password"/></label><small>Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</small><label>Nhập lại mật khẩu<input type="password" name="Input.ConfirmPassword" required autocomplete="new-password"/></label><button>Đăng ký →</button></form><p>Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p></section>
