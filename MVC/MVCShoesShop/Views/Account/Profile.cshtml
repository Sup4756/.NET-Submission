@model ShoesShop.Core.ShopState
@{ var s=Model; }
<div asp-validation-summary="All" class="validation"></div>
<div class="page-heading"><span class="eyebrow">TÀI KHOẢN</span><h1>@(s.IsAdmin?"Sửa tài khoản":"Thông tin cá nhân")</h1></div><section class="panel editor"><form method="post" action="@(s.IsAdmin?$"/Admin/Accounts/Edit/{s.UserId}":"/Profile")">@Html.AntiForgeryToken()<div class="form-grid"><label>Họ và tên<input name="Input.FullName" value="@s.Profile.FullName" required maxlength="100"/></label><label>Email<input name="Input.Email" type="email" value="@s.Profile.Email" required/></label><label>Giới tính<select name="Input.Gender">@foreach(var g in new[]{"","Nam","Nữ","Khác"}){<option value="@g" selected="@(s.Profile.Gender==g)">@(g==""?"Chưa chọn":g)</option>}</select></label><label>Ngày sinh<input name="Input.DateOfBirth" type="date" value="@(s.Profile.DateOfBirth?.ToString("yyyy-MM-dd"))"/></label><label>Số điện thoại<input name="Input.PhoneNumber" type="tel" value="@s.Profile.PhoneNumber"/></label><label>Thành phố<input name="Input.City" value="@s.Profile.City" maxlength="100"/></label><label class="full">Địa chỉ<input name="Input.Address" value="@s.Profile.Address" maxlength="250"/></label>@if(s.IsAdmin){<label>Vai trò<select name="Input.Role"><option value="User" selected="@(s.Profile.Role=="User")">User</option><option value="Admin" selected="@(s.Profile.Role=="Admin")">Admin</option></select></label><label>Trạng thái<select name="Input.Locked"><option value="false" selected="@(!s.Profile.Locked)">Hoạt động</option><option value="true" selected="@s.Profile.Locked">Khóa tài khoản</option></select></label>}</div><button>Lưu thay đổi</button></form></section>
