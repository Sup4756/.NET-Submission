@page "/Products"
@inherits ShopComponent

<PageTitle>STEP Shoes</PageTitle>
@if(message is not null){<div class="notice" role="status">@message</div>}
<div class="page-heading"><span class="eyebrow">TÌM ĐÔI GIÀY CỦA BẠN</span><h1>Sản phẩm</h1><p>Thiết kế đẹp, cảm giác thoải mái — chọn phong cách của bạn.</p></div><div class="catalog"><aside class="filter panel"><h3>Bộ lọc</h3><form method="get" action="/Products"><label>Tìm kiếm<input name="q" value="@s.Q" placeholder="Tên sản phẩm, thương hiệu"/></label><label>Danh mục<select name="category"><option value="">Tất cả danh mục</option>@foreach(var c in s.Categories){<option value="@c" selected="@(s.Category==c)">@c</option>}</select></label><label>Thương hiệu<select name="brand"><option value="">Tất cả thương hiệu</option>@foreach(var b in s.Brands){<option value="@b" selected="@(s.Brand==b)">@b</option>}</select></label><label>Giá từ (₫)<input name="min" type="number" min="0" value="@s.Min"/></label><label>Giá đến (₫)<input name="max" type="number" min="0" value="@s.Max"/></label><button>Lọc sản phẩm</button><a href="/Products">Xóa bộ lọc</a></form></aside><section><div class="row-between results"><span><strong>@s.Count</strong> sản phẩm</span><span>Trang @s.Page / @s.Pages</span></div><div class="product-grid">@foreach(var p in s.Products){<article class="product-card"><a class="product-art tone-@(p.Id%3)" href="/Products/@p.Id"><span class="tag">@p.Category</span><img src="/images/shoe.svg" alt="@p.Name" loading="lazy"/></a><div class="product-info"><small>@p.Brand</small><h3><a href="/Products/@p.Id">@p.Name</a></h3><div class="row-between"><strong>@p.Price.ToString("N0") ₫</strong><a class="round-link" href="/Products/@p.Id" aria-label="Xem chi tiết">→</a></div></div></article>}</div> @if(s.Products.Count==0){<div class="empty panel">Không tìm thấy sản phẩm phù hợp.</div>}<nav class="pagination" aria-label="Phân trang">@for(var i=1;i<=s.Pages;i++){<a class="@(i==s.Page?"active":"")" href="@($"/Products?q={Uri.EscapeDataString(s.Q??"")}&category={Uri.EscapeDataString(s.Category??"")}&brand={Uri.EscapeDataString(s.Brand??"")}&min={s.Min}&max={s.Max}&page={i}")">@i</a>}</nav></section></div>
@code {

[SupplyParameterFromQuery(Name="q")] public string? Q{get;set;}
[SupplyParameterFromQuery]public string? Category{get;set;}
[SupplyParameterFromQuery]public string? Brand{get;set;}
[SupplyParameterFromQuery]public decimal? Min{get;set;}
[SupplyParameterFromQuery]public decimal? Max{get;set;}
[SupplyParameterFromQuery(Name="page")]public int Page{get;set;}=1;
protected override async Task OnInitializedAsync(){s=await queries.Products(Q,Category,Brand,Min,Max,Page);}

}
