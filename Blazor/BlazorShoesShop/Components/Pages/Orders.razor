@page "/Orders"
@inherits ShopComponent
@attribute [Authorize]
<PageTitle>STEP Shoes</PageTitle>
@if(message is not null){<div class="notice" role="status">@message</div>}
<div class="page-heading"><span class="eyebrow">LỊCH SỬ MUA SẮM</span><h1>Đơn hàng của tôi</h1></div>@if(s.Orders.Count==0){<div class="empty panel">Chưa có đơn hàng.</div>}@foreach(var order in s.Orders){<article class="panel order"><div class="row-between"><h3>Đơn hàng #@order.Id</h3><span class="badge">@order.Status</span></div><p class="muted">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @order.Recipient · @order.Phone</p><p>@order.ShippingAddress</p><table><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th></tr></thead><tbody>@foreach(var line in order.Lines){<tr><td>@line.ProductName</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("N0") ₫</td></tr>}</tbody></table><div class="row-between total"><span>Tổng đơn hàng</span><strong>@order.Total.ToString("N0") ₫</strong></div></article>}
@code {
protected override async Task OnInitializedAsync(){s.Orders=await db.Orders.Include(x=>x.Lines).Where(x=>x.UserId==UserId).OrderByDescending(x=>x.Id).ToListAsync();}
}
