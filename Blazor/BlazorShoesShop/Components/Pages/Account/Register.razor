@page "/Account/Register"
@inherits ShopComponent

<PageTitle>STEP Shoes</PageTitle>
@if(message is not null){<div class="notice" role="status">@message</div>}
<section class="auth panel"><span class="eyebrow">GIA NHẬP STEP SHOES</span><h1>Tạo tài khoản</h1><form method="post" @onsubmit="Submit" @formname="register"><AntiforgeryToken/><label>Họ và tên<input name="Input.FullName" required maxlength="100" value="@s.Register.FullName"/></label><label>Email<input type="email" name="Input.Email" required value="@s.Register.Email" autocomplete="username"/></label><label>Mật khẩu<input type="password" name="Input.Password" required minlength="8" autocomplete="new-password"/></label><small>Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</small><label>Nhập lại mật khẩu<input type="password" name="Input.ConfirmPassword" required autocomplete="new-password"/></label><button>Đăng ký →</button></form><p>Đã có tài khoản? <a href="/Account/Login">Đăng nhập</a></p></section>
@code {

[SupplyParameterFromForm]public RegisterInput? Input{get;set;}
protected override void OnInitialized(){Input??=new();s.Register=Input;}
async Task Submit(){if(!Validate(Input!))return;var u=new AppUser{UserName=Input!.Email,Email=Input.Email,FullName=Input.FullName};var result=await users.CreateAsync(u,Input.Password);if(result.Succeeded){await users.AddToRoleAsync(u,"User");await signIn.SignInAsync(u,false);nav.NavigateTo("/Products");}else message=string.Join(" ",result.Errors.Select(x=>x.Description));}

}
