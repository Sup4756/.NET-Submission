@page "/Admin/Accounts"
@page "/Admin/Customers"
@inherits ShopComponent
@attribute [Authorize(Roles="Admin")]
<PageTitle>STEP Shoes</PageTitle>
@if(message is not null){<div class="notice" role="status">@message</div>}
<div class="page-heading"><span class="eyebrow">NGƯỜI DÙNG HỆ THỐNG</span><h1>Khách hàng &amp; tài khoản</h1></div><form method="get" class="panel user-filter"><input name="q" value="@s.Q" placeholder="Họ tên, email, SĐT, địa chỉ"/><input name="city" placeholder="Thành phố"/><input name="birthDate" type="date" aria-label="Ngày sinh"/><select name="role"><option value="">Mọi vai trò</option><option>User</option><option>Admin</option></select><select name="gender"><option value="">Mọi giới tính</option><option>Nam</option><option>Nữ</option><option>Khác</option></select><select name="locked"><option value="">Mọi trạng thái</option><option value="false">Hoạt động</option><option value="true">Đã khóa</option></select><button>Lọc</button></form><div class="panel table-wrap"><table><thead><tr><th>Khách hàng</th><th>Email / SĐT</th><th>Giới tính / Ngày sinh</th><th>Địa chỉ / Thành phố</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in s.Users){<tr><td>@u.FullName</td><td>@u.Email<br/><small>@u.PhoneNumber</small></td><td>@u.Gender<br/><small>@u.DateOfBirth?.ToString("dd/MM/yyyy")</small></td><td>@u.Address<br/><small>@u.City</small></td><td>@s.Roles.GetValueOrDefault(u.Id,"User")</td><td><span class="badge">@(u.LockoutEnd>DateTimeOffset.UtcNow?"Đã khóa":"Hoạt động")</span></td><td class="actions"><a href="/Admin/Accounts/Edit/@u.Id">Xem / Sửa</a><form method="post" @onsubmit="Delete" @formname="@($"user-{u.Id}")"><AntiforgeryToken/><input type="hidden" name="id" value="@u.Id"/><button class="danger" onclick="return confirm('Xóa mềm tài khoản này?')">Xóa</button></form></td></tr>}</tbody></table>@if(s.Users.Count==0){<p>Không tìm thấy tài khoản.</p>}</div>
@code {

[SupplyParameterFromQuery(Name="q")]public string? Q{get;set;}
[SupplyParameterFromQuery]public string? Role{get;set;}
[SupplyParameterFromQuery]public string? City{get;set;}
[SupplyParameterFromQuery]public string? Gender{get;set;}
[SupplyParameterFromQuery]public DateTime? BirthDate{get;set;}
[SupplyParameterFromQuery]public string? Locked{get;set;}
[SupplyParameterFromForm(Name="id")]public string? ItemId{get;set;}
protected override async Task OnInitializedAsync(){s=await queries.Users(Q,Http.Request.Path=="/Admin/Customers"?"User":Role,City,Gender,Locked,BirthDate);}
async Task Delete()=>await Run(async()=>{await accounts.Delete(ItemId??"",UserId);nav.NavigateTo("/Admin/Accounts");});

}
