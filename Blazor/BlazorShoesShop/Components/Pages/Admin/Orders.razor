@page "/Admin/Orders"
@inherits ShopComponent
@attribute [Authorize(Roles="Admin")]
<PageTitle>STEP Shoes</PageTitle>
@if(message is not null){<div class="notice" role="status">@message</div>}
<div class="page-heading"><span class="eyebrow">XỬ LÝ ĐƠN HÀNG</span><h1>Quản lý đơn hàng</h1><p>Đơn mới → Đang xử lý → Đang giao → Hoàn thành. Có thể hủy trước khi giao.</p></div>@if(s.Orders.Count==0){<div class="empty panel">Chưa có đơn hàng.</div>}@foreach(var order in s.Orders){<article class="panel order"><div class="row-between"><h3>Đơn hàng #@order.Id</h3><span class="badge">@order.Status</span></div><p class="muted">@order.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @order.Recipient · @order.Phone</p><p>@order.ShippingAddress</p><table><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th></tr></thead><tbody>@foreach(var line in order.Lines){<tr><td>@line.ProductName</td><td>@line.Quantity</td><td>@line.UnitPrice.ToString("N0") ₫</td></tr>}</tbody></table><div class="row-between total"><span>Tổng đơn hàng</span><strong>@order.Total.ToString("N0") ₫</strong></div><form method="post" @onsubmit="Update" @formname="@($"order-{order.Id}")"><AntiforgeryToken/><input type="hidden" name="id" value="@order.Id"/><select name="status">@foreach(var status in ShopService.Statuses){<option selected="@(status==order.Status)">@status</option>}</select><button>Cập nhật trạng thái</button></form></article>}
@code {

[SupplyParameterFromForm(Name="id")]public int ItemId{get;set;}
[SupplyParameterFromForm(Name="status")]public string? Status{get;set;}
protected override async Task OnInitializedAsync(){s.Orders=await db.Orders.Include(x=>x.Lines).OrderByDescending(x=>x.Id).ToListAsync();}
async Task Update()=>await Run(async()=>{await shop.UpdateOrder(ItemId,Status??"");nav.NavigateTo("/Admin/Orders");});

}
